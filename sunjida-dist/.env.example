# Application Configuration
APP_NAME=Sunjida
APP_ENV=production
APP_DEBUG=false
APP_URL=https://salesdaddy.torquesticker.com
APP_KEY=your-32-char-secret-key-here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sunjida
DB_USER=sunjida
DB_PASS=your-database-password

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRY=86400

# Meta/Facebook Configuration
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=your-webhook-verify-token
META_PAGE_ACCESS_TOKEN=your-page-access-token

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Lovable Backend Configuration
LOVABLE_API_URL=https://api.lovable.dev
LOVABLE_API_KEY=your-lovable-api-key
LOVABLE_TTS_URL=https://api.lovable.dev/tts

# Rate Limiting
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# CORS
CORS_ALLOWED_ORIGINS=https://salesdaddy.torquesticker.com,https://torquesticker.com
